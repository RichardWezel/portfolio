# Angular-Routen: prerenderte Seiten direkt ausliefern, Rest an index.html.
RewriteEngine On
RewriteBase /

# /lebenslauf -> lebenslauf/index.html (ohne 301 auf /lebenslauf/)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+[^/])$ $1/index.html [L]

# Alles, was keine Datei und kein Ordner ist, bekommt die App (SPA-Fallback)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
